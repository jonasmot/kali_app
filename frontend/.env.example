# ============================================================
# Kali App — Variáveis de Ambiente (Frontend Vite)
# ============================================================
# Copie para ".env" (dev) ou ".env.production" (produção).
# ============================================================

# URL do backend NestJS
# Desenvolvimento: http://localhost:3000
# Produção: https://seu-backend.railway.app
VITE_API_URL="http://localhost:3000"

# Supabase Storage — URL base para vídeos
# Padrão: https://[SEU-PROJECT-REF].supabase.co/storage/v1/object/public/kali-videos
VITE_SUPABASE_STORAGE_URL="https://[SEU-PROJECT-REF].supabase.co/storage/v1/object/public/kali-videos"
