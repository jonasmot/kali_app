// ============================================
// Kali App — Prisma Schema
// ============================================
// Modelos do banco de dados PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Usuário da plataforma.
model Usuario {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  senha          String
  nome           String
  criado_em      DateTime @default(now())
  atualizado_em  DateTime @updatedAt

  treinos     Treino[]

  @@map("usuarios")
}

/// Exercício de calistenia. Fixo no sistema.
model Exercicio {
  id             Int      @id @default(autoincrement())
  titulo         String
  descricao      String?
  grupo_muscular String
  video_url      String?
  criado_em      DateTime @default(now())

  treinos TreinoExercicio[]

  @@map("exercicios")
}

/// Treino (rotina de exercícios) pertencente a um usuário.
model Treino {
  id            Int      @id @default(autoincrement())
  nome          String
  descricao     String?
  usuario_id    Int
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  usuario    Usuario           @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  exercicios TreinoExercicio[]

  @@map("treinos")
}

/// Tabela de junção entre Treino e Exercicio.
model TreinoExercicio {
  id           Int     @id @default(autoincrement())
  treino_id    Int
  exercicio_id Int
  concluido    Boolean @default(false)
  ordem        Int     @default(0)
  series       Int?
  repeticoes   Int?

  treino    Treino    @relation(fields: [treino_id], references: [id], onDelete: Cascade)
  exercicio Exercicio @relation(fields: [exercicio_id], references: [id])

  @@unique([treino_id, exercicio_id])
  @@map("treino_exercicios")
}