# ============================================
# Kali App — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Banco de Dados (PostgreSQL) ---
DATABASE_URL="postgresql://usuario:senha@localhost:5432/kali_db?schema=public"

# --- JWT ---
JWT_SECRET=sua_chave_secreta_aqui_troque_em_producao
JWT_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Vídeos (caminho absoluto para pasta de vídeos de exercícios) ---
VIDEOS_PATH=C:\Users\jonas\Videos\kali_vids
